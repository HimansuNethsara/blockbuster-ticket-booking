<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
  <session-factory>
    <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>
    <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
    <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/block_buster?useSSL=false&amp;allowPublicKeyRetrieval=true</property>
    <property name="hibernate.connection.username">root</property>
    <property name="hibernate.connection.password">YOUR_DB_PASSWORD/property>
    <property name="hibernate.show_sql">true</property>
    <mapping class="hibernate.User"/>
    <mapping class="hibernate.City"/>
    <mapping class="hibernate.Address"/>
    <mapping class="hibernate.Admin"/>
    <mapping class="hibernate.MpaaRating"/>
    <mapping class="hibernate.Genre"/>
    <mapping class="hibernate.Actors"/>
    <mapping class="hibernate.Directors"/>
    <mapping class="hibernate.Keyword"/>
    <mapping class="hibernate.Status"/>
    <mapping class="hibernate.Movie"/>
    <mapping class="hibernate.Cinema"/>
    <mapping class="hibernate.Hall"/>
    <mapping class="hibernate.Showtime"/>
    <mapping class="hibernate.Ticket"/>
    <mapping class="hibernate.Cart"/>
    <mapping class="hibernate.CartItem"/>
    <mapping class="hibernate.CartStatus"/>
    <mapping class="hibernate.BookingStatus"/>
    <mapping class="hibernate.Booking"/>
    <mapping class="hibernate.BookingItems"/>
  </session-factory>
</hibernate-configuration>
